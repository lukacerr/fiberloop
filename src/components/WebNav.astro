---
interface Props {
	/** Página activa para resaltar el item correspondiente en la navegación. */
	current?: 'web' | 'estadisticas';
}

const { current = 'web' } = Astro.props;

const sectionLinks = [
	{ label: 'Problema', href: '/web#problema' },
	{ label: 'Cómo funciona', href: '/web#funciona' },
	{ label: 'Impacto', href: '/web#impacto' },
];

const statsActive = current === 'estadisticas';
---

<header class="sticky top-0 z-50 border-b border-white/60 bg-white/80 backdrop-blur-xl">
	<nav
		class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-4 sm:px-8"
		aria-label="Navegación principal"
	>
		<a
			href="/"
			class="flex shrink-0 items-center gap-3 rounded-full focus:outline-none focus:ring-2 focus:ring-fiber-blue-400 focus:ring-offset-4"
		>
			<img src="/fiberloop-logo.png" alt="FiberLoop" class="h-auto w-36 sm:w-48" />
		</a>

		<div class="hidden items-center gap-7 text-sm font-bold text-slate-600 md:flex">
			{
				sectionLinks.map((link) => (
					<a href={link.href} class="transition hover:text-fiber-blue-700">
						{link.label}
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href="/web/estadisticas"
				aria-current={statsActive ? 'page' : undefined}
				class:list={[
					'rounded-full border px-3.5 py-2 text-sm font-black transition focus:outline-none focus:ring-2 focus:ring-fiber-blue-400 focus:ring-offset-4 sm:px-4',
					statsActive
						? 'border-fiber-blue-300 bg-fiber-blue-50 text-fiber-blue-700'
						: 'border-fiber-blue-200 bg-white text-fiber-blue-700 hover:-translate-y-0.5 hover:border-fiber-blue-400 motion-reduce:hover:translate-y-0',
				]}
			>
				Estadísticas
			</a>
			<a
				href="/mobile"
				class="rounded-full bg-fiber-blue-600 px-3.5 py-2 text-sm font-black text-white shadow-lg shadow-fiber-blue-600/20 transition hover:-translate-y-0.5 hover:bg-fiber-blue-700 focus:outline-none focus:ring-2 focus:ring-fiber-blue-400 focus:ring-offset-4 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:px-4"
			>
				Ver app mock
			</a>
		</div>
	</nav>
</header>
