---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="App móvil FiberLoop" bodyClass="min-h-screen bg-fiber-deep text-white">
	<main class="grid min-h-screen place-items-center px-6 py-16">
		<section class="w-full max-w-2xl rounded-3xl border border-white/15 bg-white/10 p-8 text-center shadow-xl backdrop-blur md:p-12">
			<img src="/fiberloop-logo.png" alt="FiberLoop" class="mx-auto mb-8 h-auto w-full max-w-sm" />
			<p class="mb-3 text-sm font-semibold uppercase tracking-[0.3em] text-fiber-cyan">Próximamente</p>
			<h1 class="text-4xl font-black tracking-tight">Mock de app móvil</h1>
			<p class="mt-4 text-lg leading-8 text-slate-200">
				Esta ruta mostrará el estado del filtro, cartucho, historial, puntos de recolección, recompensas y QR.
			</p>
			<a class="mt-8 inline-flex rounded-full bg-primary px-6 py-3 font-bold text-primary-foreground" href="/">Volver al inicio</a>
		</section>
	</main>
</BaseLayout>
