---
import PresentationDeck from '@/components/PresentationDeck.astro';
import { presentationSlides } from '@/data/presentation';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
	return presentationSlides.map((_, index) => ({
		params: { slide: String(index + 1) },
		props: { slide: index + 1 },
	}));
}

interface Props {
	slide: number;
}

const { slide } = Astro.props;
---

<BaseLayout
	title={`Presentación FiberLoop | Slide ${slide}`}
	description="Deck estático de FiberLoop para explicar la captura de microfibras textiles en origen."
	bodyClass="presentation-page"
>
	<PresentationDeck initialSlide={slide} />
</BaseLayout>
