---
import BaseLayout from '@/layouts/BaseLayout.astro';

const mocks = [
	{
		title: 'Presentación',
		description:
			'Diapositivas para exponer el problema, la solución y el prototipo.',
		href: '/presentacion',
		meta: '01',
	},
	{
		title: 'Web promocional',
		description: 'Landing del concepto FiberLoop y su impacto ambiental.',
		href: '/web',
		meta: '02',
	},
	{
		title: 'App móvil',
		description:
			'Mock de estado del filtro, QR, puntos de entrega y recompensas.',
		href: '/mobile',
		meta: '03',
	},
];

const teamMembers = [
	'Artimiak J.',
	'Cerrutti L.',
	'Costa F.',
	'Iglesias S.',
	'Lanzillotta E.',
	'Lombardo C.',
];

const resources = [
	{
		title: 'Notas guia para la presentacion',
		description: 'Puntos breves para exponer el proyecto en clase.',
		href: 'https://github.com/lukacerr/fiberloop/blob/main/notas.md',
	},
	{
		title: 'Documento entregable',
		description: 'PDF del TP integrador con problema, solucion e impactos.',
		href: 'https://github.com/lukacerr/fiberloop/blob/main/Document.pdf',
	},
	{
		title: 'Boceto de trabajo',
		description: 'Documento colaborativo usado para organizar el contenido.',
		href: 'https://docs.google.com/document/d/1Xp-l9wwefDbnqrUNpdiOvS17iJdRzu01KAPwxAb2bc0/edit?tab=t.0#heading=h.7oknbbqf2duf',
	},
];
---

<BaseLayout
	title="FiberLoop | Mocks"
	description="Portal de mocks para FiberLoop: presentación, web promocional y app móvil."
	bodyClass="min-h-dvh bg-white text-slate-950"
>
	<main class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col justify-center px-5 py-4 sm:px-8">
		<section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
			<header class="flex flex-col gap-4 border-b border-slate-200 pb-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="flex items-center gap-4">
					<div class="grid h-14 w-20 place-items-center rounded-2xl border border-slate-200 bg-white text-2xl font-black tracking-tighter text-slate-900 shadow-sm">
						UADE
					</div>
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.24em] text-fiber-blue-600">Tecnología y Medio Ambiente</p>
						<p class="mt-1 text-sm text-slate-500">TP Integrador · Grupo 6</p>
						<p class="mt-2 max-w-xl text-xs leading-5 text-slate-500">
							{teamMembers.join(' · ')}
						</p>
					</div>
				</div>
				<img
					src="/fiberloop-logo.png"
					alt="FiberLoop"
					class="h-auto w-44 sm:w-56"
				/>
			</header>

			<div class="py-6 sm:py-7">
				<p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-fiber-blue-600">FiberLoop</p>
				<h1 class="max-w-3xl text-balance text-4xl font-black tracking-tight text-slate-950 sm:text-[2.65rem]">
					Mocks del proyecto
				</h1>
				<p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
					Portal estático para acceder a la presentación, la web promocional y el mock móvil.
				</p>
				<p class="mt-3 inline-flex rounded-full border border-fiber-blue-100 bg-fiber-blue-50 px-3 py-1.5 text-xs font-bold text-fiber-blue-700">
					Nota: los mocks están optimizados para desktop; en mobile la experiencia puede verse limitada.
				</p>
			</div>

			<nav aria-label="Mocks del proyecto" class="grid gap-4 md:grid-cols-3">
				{mocks.map((mock) => (
					<a
						href={mock.href}
						class="group rounded-2xl border border-slate-200 bg-slate-50 p-4 text-left transition duration-200 hover:-translate-y-0.5 hover:border-fiber-blue-400 hover:bg-white hover:shadow-md focus:outline-none focus:ring-2 focus:ring-fiber-blue-400 focus:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
					>
						<span class="mb-4 inline-flex rounded-full bg-fiber-blue-100 px-3 py-1 text-xs font-bold text-fiber-blue-700">{mock.meta}</span>
						<h2 class="text-xl font-black tracking-tight text-slate-950">{mock.title}</h2>
						<p class="mt-2 min-h-10 text-sm leading-6 text-slate-600">{mock.description}</p>
						<span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-fiber-blue-600">
							Abrir mock
							<span aria-hidden="true" class="transition group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0">-&gt;</span>
						</span>
					</a>
				))}
			</nav>

			<section class="mt-5 border-t border-slate-200 pt-5" aria-labelledby="resources-title">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.22em] text-fiber-blue-600">Recursos</p>
						<h2 id="resources-title" class="mt-1 text-2xl font-black tracking-tight text-slate-950">Material del proyecto</h2>
					</div>
					<a href="https://github.com/lukacerr/fiberloop" target="_blank" rel="noreferrer" class="text-sm font-bold text-slate-500 underline decoration-fiber-blue-300 underline-offset-4 hover:text-fiber-blue-700">
						github.com/lukacerr/fiberloop
					</a>
				</div>
				<div class="mt-4 grid gap-4 md:grid-cols-3">
					{resources.map((resource) => (
						<a
							href={resource.href}
							target="_blank"
							rel="noreferrer"
							class="group rounded-2xl border border-slate-200 bg-white p-4 text-left transition duration-200 hover:-translate-y-0.5 hover:border-fiber-blue-400 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-fiber-blue-400 focus:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
						>
							<h3 class="text-lg font-black tracking-tight text-slate-950">{resource.title}</h3>
							<p class="mt-2 text-sm leading-6 text-slate-600">{resource.description}</p>
							<span class="mt-3 inline-flex text-sm font-bold text-fiber-blue-600">Abrir en nueva pestaña -&gt;</span>
						</a>
					))}
				</div>
			</section>
		</section>
	</main>
</BaseLayout>
